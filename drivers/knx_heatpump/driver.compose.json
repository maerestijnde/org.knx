{
  "$extends": [
    "knx_driver"
  ],
  "id": "knx_heatpump",
  "name": {
    "en": "Heat Pump",
    "nl": "Warmtepomp"
  },
  "class": "sensor",
  "capabilities": [
    "measure_temperature.outside",
    "measure_temperature.hc1_flow",
    "measure_temperature.dhw",
    "measure_pressure",
    "target_temperature",
    "onoff.dhw_mode",
    "target_temperature.dhw",
    "onoff.status_standby",
    "onoff.status_heating",
    "onoff.status_cooling",
    "onoff.status_dhw",
    "alarm_generic.knx_error",
    "alarm_generic.heating_error",
    "measure_power.dhw",
    "measure_power.heating_generator",
    "measure_power.environmental_yield",
    "meter_power.dhw_consumption",
    "meter_power.heating_consumption"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "title": {
        "en": "Target Temperature HC1",
        "nl": "Doeltemperatuur HC1"
      },
      "min": 5,
      "max": 30,
      "step": 0.5,
      "decimals": 1,
      "uiIndicator": true
    },
    "measure_temperature.outside": {
      "title": {
        "en": "Outside Temperature",
        "nl": "Buitentemperatuur"
      },
      "chartType": "spline",
      "decimals": 1,
      "insights": true,
      "uiIndicator": true
    },
    "measure_temperature.hc1_flow": {
      "title": {
        "en": "HC1 Flow Temperature",
        "nl": "HC1 Aanvoer Temperatuur"
      },
      "chartType": "spline",
      "decimals": 1,
      "insights": true,
      "uiIndicator": false
    },
    "measure_temperature.dhw": {
      "title": {
        "en": "DHW Temperature",
        "nl": "Warmwater Temperatuur"
      },
      "chartType": "spline",
      "decimals": 1,
      "insights": true,
      "uiIndicator": false
    },
    "measure_pressure": {
      "title": {
        "en": "Water Pressure",
        "nl": "Waterdruk"
      },
      "units": {
        "en": "bar",
        "nl": "bar"
      },
      "chartType": "spline",
      "decimals": 1,
      "insights": true,
      "uiIndicator": false
    },
    "onoff.dhw_mode": {
      "title": {
        "en": "DHW Mode",
        "nl": "Warmwater Modus"
      },
      "uiComponent": "toggle",
      "uiQuickAction": true,
      "getable": true,
      "setable": true
    },
    "target_temperature.dhw": {
      "title": {
        "en": "DHW Target Temperature",
        "nl": "Warmwater Doeltemperatuur"
      },
      "min": 35,
      "max": 65,
      "step": 1,
      "decimals": 0,
      "uiIndicator": false
    },
    "onoff.status_standby": {
      "title": {
        "en": "Standby Mode",
        "nl": "Standby Modus"
      },
      "uiComponent": "sensor",
      "uiQuickAction": false,
      "getable": true,
      "setable": false
    },
    "onoff.status_heating": {
      "title": {
        "en": "Heating Active",
        "nl": "Verwarmen Actief"
      },
      "uiComponent": "sensor",
      "uiQuickAction": false,
      "getable": true,
      "setable": false
    },
    "onoff.status_cooling": {
      "title": {
        "en": "Cooling Active",
        "nl": "Koelen Actief"
      },
      "uiComponent": "sensor",
      "uiQuickAction": false,
      "getable": true,
      "setable": false
    },
    "onoff.status_dhw": {
      "title": {
        "en": "DHW Active",
        "nl": "Warmwater Actief"
      },
      "uiComponent": "sensor",
      "uiQuickAction": false,
      "getable": true,
      "setable": false
    },
    "alarm_generic.knx_error": {
      "title": {
        "en": "KNX Gateway Error",
        "nl": "KNX Gateway Fout"
      },
      "uiComponent": "sensor"
    },
    "alarm_generic.heating_error": {
      "title": {
        "en": "Heating Generator Error",
        "nl": "Verwarmingsgenerator Fout"
      },
      "uiComponent": "sensor"
    },
    "measure_power.dhw": {
      "title": {
        "en": "DHW Power Consumption",
        "nl": "Warmwater Stroomverbruik"
      },
      "units": {
        "en": "W",
        "nl": "W"
      },
      "chartType": "stepLine",
      "decimals": 0,
      "insights": true,
      "uiIndicator": false
    },
    "measure_power.heating_generator": {
      "title": {
        "en": "Heating Generator Power",
        "nl": "Verwarmingsgenerator Vermogen"
      },
      "units": {
        "en": "W",
        "nl": "W"
      },
      "chartType": "stepLine",
      "decimals": 0,
      "insights": true,
      "uiIndicator": false
    },
    "measure_power.environmental_yield": {
      "title": {
        "en": "Environmental Yield",
        "nl": "Milieu Opbrengst"
      },
      "units": {
        "en": "Wh",
        "nl": "Wh"
      },
      "chartType": "stepLine",
      "decimals": 0,
      "insights": true,
      "uiIndicator": false
    },
    "meter_power.dhw_consumption": {
      "title": {
        "en": "DHW Total Energy",
        "nl": "Warmwater Totaal Energie"
      },
      "units": {
        "en": "kWh",
        "nl": "kWh"
      },
      "decimals": 2,
      "insights": true,
      "uiIndicator": false
    },
    "meter_power.heating_consumption": {
      "title": {
        "en": "Heating Total Energy",
        "nl": "Verwarming Totaal Energie"
      },
      "units": {
        "en": "kWh",
        "nl": "kWh"
      },
      "decimals": 2,
      "insights": true,
      "uiIndicator": false
    }
  },
  "pair": [
    {
      "id": "select_interface",
      "$template": "select_interface",
      "navigation": {
        "next": "select_groupaddresses"
      }
    },
    {
      "id": "parse_knxproj",
      "$template": "parse_knxproj",
      "navigation": {
        "next": "select_groupaddresses",
        "prev": "select_groupaddresses"
      }
    },
    {
      "id": "select_groupaddresses",
      "$template": "select_groupaddresses",
      "options": {
        "devicetype": "heatpump"
      },
      "navigation": {
        "prev": "select_interface"
      }
    }
  ],
  "images": {
    "large": "{{driverAssetsPath}}/images/large.png",
    "small": "{{driverAssetsPath}}/images/small.png"
  },
